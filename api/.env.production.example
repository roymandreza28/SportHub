# Production template for the "web" and "reverb" services (originally
# written for Railway; applies equally to Render or any other host running
# api/Dockerfile). Copy the values that apply into each service's
# environment variables — do not commit a real .env with secrets. Both
# services should share the same APP_KEY, DB_*, and REVERB_* values so
# broadcasts stay consistent between them.
#
# Auth is Bearer-token (Sanctum personal access tokens), not cookie/session
# based — the frontend (Vercel) and API (Render/Railway/etc.) are on
# unrelated domains with no custom domain, and browsers won't share a
# session cookie across those regardless of CORS config. Because of that,
# SESSION_DOMAIN/SANCTUM_STATEFUL_DOMAINS are deliberately left unset below:
# setting a stateful domain makes Laravel enforce CSRF on requests from that
# origin, which the token-only frontend never sends and doesn't need. See
# AuthController::login()/register() (creates the token) and
# routes/channels.php (Broadcast::routes() forced onto 'auth:sanctum' so
# real-time channel auth accepts the same token).

APP_NAME=Sporthub
APP_ENV=production
# Generate once with `php artisan key:generate --show` and paste the same
# value into both the web and reverb services — do not regenerate per service.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api-host.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Wire these to your Postgres service's connection details (Railway exposes
# reference variables like ${{Postgres.PGHOST}}; Render's "Internal Database
# URL" needs splitting into these discrete fields instead).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Intentionally empty — see the note above. Do not set these to the
# frontend's domain; that would turn on cookie/CSRF handling the token-only
# frontend never uses, which breaks login (419) rather than helping it.
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=

CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# The "public" disk (post images, news covers, avatars, etc.) defaults to
# the local filesystem — fine for dev, but Render's (and most PaaS) web
# service disks are EPHEMERAL: anything written at runtime is wiped on the
# next deploy or restart. Point it at an S3-compatible bucket instead so
# uploads actually persist. Leave FILESYSTEM_PUBLIC_DRIVER unset to keep
# using the local disk (e.g. for a single-machine self-hosted deployment
# with its own persistent volume).
#
# Backblaze B2 is the one used here rather than Cloudflare R2 — R2 requires
# a credit/debit card on file to activate even its free tier, which isn't
# an option for every account; B2 is genuinely card-free to sign up for
# (backblaze.com/sign-up/cloud-storage) and gives 10GB free storage
# permanently. Any other S3-compatible provider works too, just with
# different values below — nothing else in the app is B2-specific.
FILESYSTEM_PUBLIC_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The region is embedded in B2's endpoint hostname (e.g. "us-west-004" in
# s3.us-west-004.backblazeb2.com) — use that same string here.
AWS_DEFAULT_REGION=
AWS_BUCKET=
# Shown on the bucket's own page in the B2 dashboard as "Endpoint" —
# prefix it with https://.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# The bucket's public base URL — for B2 this is the "Friendly URL" shown on
# the bucket's page (looks like https://f004.backblazeb2.com/file/<bucket-name>),
# or a custom domain you've connected to the bucket. This is what image_url
# accessors build on top of, so it must be reachable from a browser, unlike
# AWS_ENDPOINT above.
FILESYSTEM_PUBLIC_URL=

MAIL_MAILER=log

# Generate with: php -r "require 'vendor/autoload.php'; print_r(\Minishlink\WebPush\VAPID::createVapidKeys());"
# Use the SAME keys as the local .env — rotating these invalidates every
# device's existing push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sporthub.test

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=your-reverb-host.example.com
REVERB_PORT=443
REVERB_SCHEME=https
