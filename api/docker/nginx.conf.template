# Everything else in this container (supervisord, php-fpm, and every artisan
# command entrypoint.sh runs at boot) runs as root — there's no other user
# boundary in this single-tenant image (see Dockerfile: no USER directive).
# Without an explicit `user` here, nginx's workers drop to Alpine's compiled-
# in default ("nginx"), which can't reliably read files php-fpm/artisan just
# created as root (e.g. seeded/uploaded storage/app/public files) — nginx
# then falls through try_files to PHP, which 404s since no route matches a
# static asset path. Root-owned nginx workers sidesteps that mismatch
# entirely rather than chasing down every individual file/dir's permission
# bits.
user root;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;
    sendfile on;

    server {
        # Railway assigns the public port at runtime via $PORT; entrypoint.sh
        # renders this template with envsubst before nginx starts.
        listen ${PORT};
        server_name _;
        root /var/www/html/public;
        index index.php;

        client_max_body_size 20M;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location = /up {
            # Must check $uri (which never exists as a real file) first, not
            # a literal /index.php — try_files serves its first *existing*
            # candidate via the current location's config as-is, and this
            # location has no fastcgi_pass, so a literal /index.php first
            # candidate was served as raw, unexecuted PHP source instead of
            # being run. Falling through to the last argument instead
            # triggers an internal redirect that correctly re-matches into
            # the `location ~ \.php$` block below.
            try_files $uri /index.php?$query_string;
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
