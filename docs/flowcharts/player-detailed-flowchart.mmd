flowchart TD
    A["User opens app"] --> B{"Has valid token?"}
    B -- No --> C["Landing page"]
    C --> D["Login / Register"]
    D --> E["AuthController validates credentials"]
    E --> F{"Credentials valid?"}
    F -- No --> X["Show error"]
    F -- Yes --> G["Load user with roles"]
    G --> H{"Role = player?"}
    H -- Yes --> I["ProtectedRoute allows /player"]
    H -- No --> J["Route denied / redirect"]

    I --> K["PlayerPage"]
    K --> L["Load Matchmaking / Newsfeed / Tournament / Venues / Profile"]
    L --> M{"User action selected?"}
    M -- Newsfeed --> M1["GET /news + interact with news"]
    M -- Matchmaking --> M2["POST /matchmaking-requests"]
    M -- Tournament --> M3["GET /tournament-registrations/mine-as-player"]
    M -- Venues --> M4["GET /venues + POST /venue-registrations"]
    M -- Profile --> M5["GET /player-profile + social APIs"]

    M1 --> M1A{"Can interact with news?"}
    M1A -- Yes --> M1B["React / comment"]
    M1A -- No --> M1C["403"]

    M2 --> M2A{"Create matchmaking request allowed?"}
    M2A -- Yes --> M2B["Store request"]
    M2A -- No --> M2C["403"]

    M3 --> M3A{"Tournament registration open?"}
    M3A -- Yes --> M3B["Register player"]
    M3A -- No --> M3C["Not available"]

    M4 --> M4A{"Venue available and eligible?"}
    M4A -- Yes --> M4B["Create booking"]
    M4A -- No --> M4C["Validation error"]

    M5 --> M5A{"Profile owner or role valid?"}
    M5A -- Yes --> M5B["Update profile / posts / friends"]
    M5A -- No --> M5C["403"]
