flowchart TB
    classDef input fill:#dfe8e8,stroke:#2d2d2d,stroke-width:1.5px,color:#111,rx:4,ry:4
    classDef panel fill:#dfe9e7,stroke:#2d2d2d,stroke-width:1.5px,color:#111
    classDef auth fill:#d9f0e9,stroke:#2d2d2d,stroke-width:1.5px,color:#111
    classDef module fill:#e7e7e7,stroke:#2d2d2d,stroke-width:1.5px,color:#111
    classDef output fill:#d7e8d9,stroke:#2d2d2d,stroke-width:1.5px,color:#111
