    classDef db fill:#cfe0d4,stroke:#2d2d2d,stroke-width:1.5px,color:#111
    classDef loop fill:#e7e4d9,stroke:#2d2d2d,stroke-width:1.5px,color:#111

    subgraph IN[INPUTS]
        I1["User Registration\nand Profile"]
        I2["Venue / Court\nRequest"]
        I3["Tournament\nRegistration"]
        I4["Match / Score\nUpdates"]
        I5["Livestream / Chat\nActivity"]
        I6["News / Posts /\nSocial Actions"]
        I7["Verification\nDocuments"]
    end

    subgraph FE["SPORTHUB Frontend Interface<br/>(Web and Mobile App)"]
            F1["Login and Register"]
        F2["Player Dashboard"]
        F3["Coach Dashboard"]
        F4["Facilitator Dashboard"]
        F5["Organizer Dashboard"]
        F6["Admin Dashboard"]
        F7["System Navigation"]
    end

    subgraph AUTH[API & Authentication Layer]
        A1["User Authentication"]
        A2["Session Management"]
        A3["Role Authorization"]
        A4["Permission and Access\nControl"]
    end

    subgraph MOD[CORE MODULES]
        M1["Chat Module"]
        M2["Player Module"]
        M3["Coach Module"]
        M4["Venue Module"]
        M5["Tournament Module"]
        M6["Livestream Module"]
        M7["Admin Module"]
    end

    subgraph BAK[SPORTHUB Backend Services]
        S1["User Management"]
        S2["Venue Operations"]
        S3["Tournament Engine"]
        S4["Match & Scoreboard"]
        S5["Livestream Control"]
        S6["Notifications"]
        S7["Audit and Reports"]
    end

    subgraph DB[Database & Security]
        D1[("Users, Roles, and\nPermissions")]
        D2[("Venues, Courts, and\nBookings")]
        D3[("Tournaments, Matches,\nand Brackets")]
        D4[("News, Posts, and\nSocial Data")]
        D5[("Livestream, Chat,\nand Messages")]
    end

    subgraph OUT[SYSTEM OUTPUTS]
        O1["Player Alerts"]
        O2["Tournament Results"]
        O3["Venue Schedule"]
        O4["Admin Reports"]
    end

    subgraph ACT[ACTORS]
        U["User"]
        A["Admin"]
        V["Venue Facilitator"]
    end

    subgraph FB[FEEDBACK LOOP]
        FB1["Continuous\nImprovement"]
    end

    I1 --> F1
